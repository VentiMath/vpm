{
  "name": "vclassnames",
  "version": "2.5.1",
  "description": "Independent conditional class names, CSS module bindings and deduplication",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./bind": {
      "import": {
        "types": "./bind.d.mts",
        "default": "./bind.mjs"
      },
      "require": {
        "types": "./bind.d.cts",
        "default": "./bind.cjs"
      }
    },
    "./dedupe": {
      "import": {
        "types": "./dedupe.d.mts",
        "default": "./dedupe.mjs"
      },
      "require": {
        "types": "./dedupe.d.cts",
        "default": "./dedupe.cjs"
      }
    }
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.mts",
    "*.cts",
    "README.md",
    "PROVENANCE.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vclassnames"
  }
}
