{
  "name": "vaccepts",
  "version": "0.1.0",
  "description": "Express-compatible content negotiation using VPM packages",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "vnegotiator": "workspace:*",
    "vmime-types": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventimath/vpm.git",
    "directory": "packages/vaccepts"
  },
  "homepage": "https://github.com/ventimath/vpm/tree/main/packages/vaccepts"
}
