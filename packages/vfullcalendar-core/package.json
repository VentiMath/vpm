{
  "name": "vfullcalendar-core",
  "version": "7.1.3",
  "description": "FullCalendar 7's shared option types and JSON feed request, without unused peers",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
