{
  "name": "vgoogle-cloud-firestore",
  "version": "9.4.0",
  "description": "Independent application-scoped Firestore client on the VPM transport stack",
  "type": "commonjs",
  "main": "./app/index.js",
  "types": "./types/application.d.ts",
  "exports": {
    ".": {
      "types": "./types/application.d.ts",
      "default": "./app/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "app",
    "build/src/snapshot-index.js",
    "types",
    "LICENSE",
    "PROVENANCE.json",
    "README.md"
  ],
  "dependencies": {
    "vfast-deep-equal": "workspace:*",
    "vgoogle-cloud-firestore-api": "workspace:*",
    "vgoogle-gax": "workspace:*",
    "vopentelemetry-api": "workspace:*",
    "vgoogle-auth-library": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vgoogle-cloud-firestore"
  }
}
