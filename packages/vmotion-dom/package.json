{
  "name": "vmotion-dom",
  "version": "14.7.0",
  "description": "Independent numeric animation playback, values, frame scheduling and keyframe mapping",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "frame.cjs",
    "value.cjs",
    "playback.cjs",
    "mapping.cjs",
    "spring.cjs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vmotion-dom"
  },
  "dependencies": {
    "vmotion-utils": "14.7.0"
  }
}
