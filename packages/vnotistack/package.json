{
  "name": "vnotistack",
  "version": "3.0.2",
  "description": "Independent React notification queue for VentiMath",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.cts",
    "*.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vnotistack"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "vgoober": "2.1.19",
    "vclsx": "2.1.1",
    "vreact-transition-group": "4.4.5"
  }
}
