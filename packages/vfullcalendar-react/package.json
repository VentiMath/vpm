{
  "name": "vfullcalendar-react",
  "version": "7.1.3",
  "description": "Independent React calendar for VentiMath\u2019s FullCalendar 7 month, week and day workflows",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "style": "./skeleton.css",
  "exports": {
    "./package.json": "./package.json",
    "./skeleton.css": "./skeleton.css",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./public-api": {
      "types": "./public-api.d.ts",
      "default": "./public-api.js"
    },
    "./protected-api": {
      "types": "./protected-api.d.ts",
      "default": "./protected-api.js"
    },
    "./interaction": {
      "types": "./interaction.d.ts",
      "default": "./interaction.js"
    },
    "./daygrid": {
      "types": "./daygrid.d.ts",
      "default": "./daygrid.js"
    },
    "./timegrid": {
      "types": "./timegrid.d.ts",
      "default": "./timegrid.js"
    },
    "./themes/classic": {
      "types": "./themes/classic/index.d.ts",
      "default": "./themes/classic/index.js"
    },
    "./themes/classic/theme.css": "./themes/classic/theme.css",
    "./themes/classic/palette.css": "./themes/classic/palette.css",
    "./locales/fr": {
      "types": "./locales/fr.d.ts",
      "default": "./locales/fr.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "public-api.js",
    "public-api.d.ts",
    "protected-api.js",
    "protected-api.d.ts",
    "daygrid.js",
    "daygrid.d.ts",
    "timegrid.js",
    "timegrid.d.ts",
    "interaction.js",
    "interaction.d.ts",
    "src",
    "skeleton.css",
    "themes/classic",
    "locales/fr.js",
    "locales/fr.d.ts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "dependencies": {
    "vfull-ui-headless-calendar": "workspace:*",
    "vfullcalendar-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vfullcalendar-react"
  },
  "vpm": {
    "platform": "browser"
  }
}
