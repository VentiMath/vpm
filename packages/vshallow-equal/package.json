{
  "name": "vshallow-equal",
  "version": "3.1.0",
  "description": "Independent shallow comparisons with legacy array/object entry points",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./arrays": {
      "types": "./arrays.d.ts",
      "import": "./arrays.mjs",
      "require": "./arrays.cjs"
    },
    "./arrays.js": {
      "types": "./arrays.d.ts",
      "import": "./arrays.mjs",
      "require": "./arrays.cjs"
    },
    "./objects": {
      "types": "./objects.d.ts",
      "import": "./objects.mjs",
      "require": "./objects.cjs"
    },
    "./objects.js": {
      "types": "./objects.d.ts",
      "import": "./objects.mjs",
      "require": "./objects.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vshallow-equal"
  }
}
