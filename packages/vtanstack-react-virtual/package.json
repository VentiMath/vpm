{
  "name": "vtanstack-react-virtual",
  "version": "3.14.26",
  "description": "Independent React 19 table virtualization adapter with commit-bound callbacks",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "vtanstack-virtual-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vtanstack-react-virtual"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
