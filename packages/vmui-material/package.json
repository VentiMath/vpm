      },
      "require": {
        "types": "./ToggleButtonGroup.d.cts",
        "default": "./ToggleButtonGroup.cjs"
      }
    },
    "./toggleButtonGroupClasses": {
      "import": {
        "types": "./toggleButtonGroupClasses.d.mts",
        "default": "./toggleButtonGroupClasses.mjs"
      },
      "require": {
        "types": "./toggleButtonGroupClasses.d.cts",
        "default": "./toggleButtonGroupClasses.cjs"
      }
    }
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.d.cts",
    "*.d.mts",
    "README.md",
    "PROVENANCE.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
