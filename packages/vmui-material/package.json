{
  "name": "vmui-material",
  "version": "9.5.0",
  "description": "Independent Material button controls for VentiMath; remaining component families in progress",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./ButtonBase": {
      "import": {
        "types": "./ButtonBase.d.mts",
        "default": "./ButtonBase.mjs"
      },
      "require": {
        "types": "./ButtonBase.d.cts",
        "default": "./ButtonBase.cjs"
      }
    },
    "./buttonBaseClasses": {
      "import": {
        "types": "./buttonBaseClasses.d.mts",
        "default": "./buttonBaseClasses.mjs"
      },
      "require": {
        "types": "./buttonBaseClasses.d.cts",
        "default": "./buttonBaseClasses.cjs"
      }
    },
    "./Button": {
      "import": {
        "types": "./Button.d.mts",
        "default": "./Button.mjs"
      },
      "require": {
        "types": "./Button.d.cts",
        "default": "./Button.cjs"
      }
    },
    "./buttonClasses": {
      "import": {
        "types": "./buttonClasses.d.mts",
        "default": "./buttonClasses.mjs"
      },
      "require": {
        "types": "./buttonClasses.d.cts",
        "default": "./buttonClasses.cjs"
      }
    },
    "./IconButton": {
      "import": {
        "types": "./IconButton.d.mts",
