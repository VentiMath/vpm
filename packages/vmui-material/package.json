      },
      "require": {
        "types": "./IconButton.d.cts",
        "default": "./IconButton.cjs"
      }
    },
    "./iconButtonClasses": {
      "import": {
        "types": "./iconButtonClasses.d.mts",
        "default": "./iconButtonClasses.mjs"
      },
      "require": {
        "types": "./iconButtonClasses.d.cts",
        "default": "./iconButtonClasses.cjs"
      }
    },
    "./Fab": {
      "import": {
        "types": "./Fab.d.mts",
        "default": "./Fab.mjs"
      },
      "require": {
        "types": "./Fab.d.cts",
        "default": "./Fab.cjs"
      }
    },
    "./fabClasses": {
      "import": {
        "types": "./fabClasses.d.mts",
        "default": "./fabClasses.mjs"
      },
      "require": {
        "types": "./fabClasses.d.cts",
        "default": "./fabClasses.cjs"
      }
    },
    "./ButtonGroup": {
      "import": {
        "types": "./ButtonGroup.d.mts",
