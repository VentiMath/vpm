      },
      "require": {
        "types": "./ButtonGroup.d.cts",
        "default": "./ButtonGroup.cjs"
      }
    },
    "./buttonGroupClasses": {
      "import": {
        "types": "./buttonGroupClasses.d.mts",
        "default": "./buttonGroupClasses.mjs"
      },
      "require": {
        "types": "./buttonGroupClasses.d.cts",
        "default": "./buttonGroupClasses.cjs"
      }
    },
    "./ToggleButton": {
      "import": {
        "types": "./ToggleButton.d.mts",
        "default": "./ToggleButton.mjs"
      },
      "require": {
        "types": "./ToggleButton.d.cts",
        "default": "./ToggleButton.cjs"
      }
    },
    "./toggleButtonClasses": {
      "import": {
        "types": "./toggleButtonClasses.d.mts",
