{
  "name": "vgoogle-gax",
  "version": "6.14.0",
  "description": "Independent Firestore-facing Google API calls, retries, paging and RPC/REST transports",
  "type": "commonjs",
  "main": "./app-runtime/index.cjs",
  "types": "./app-runtime/index.d.ts",
  "exports": {
    ".": {
      "types": "./app-runtime/index.d.ts",
      "require": "./app-runtime/index.cjs",
      "default": "./app-runtime/index.mjs"
    },
    "./fallback": {
      "types": "./app-runtime/fallback.d.ts",
      "require": "./app-runtime/fallback.cjs",
      "default": "./app-runtime/fallback.mjs"
    },
    "./gax": {
      "types": "./app-runtime/settings.d.ts",
      "default": "./app-runtime/settings.cjs"
    },
    "./build/src/protobuf": {
      "types": "./build/src/protobuf.d.ts",
      "default": "./build/src/protobuf.js"
    },
    "./build/src/index.js": {
      "types": "./app-runtime/index.d.ts",
      "default": "./app-runtime/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "index.mjs",
    "fallback.mjs",
    "LICENSE",
    "PROVENANCE.json",
    "README.md",
    "app-runtime"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "vgrpc-js": "workspace:*",
    "vgrpc-proto-loader": "workspace:*",
    "vopentelemetry-api": "workspace:*",
    "vduplexify": "workspace:*",
    "vgoogle-auth-library": "workspace:*",
    "vgoogle-logging-utils": "workspace:*",
    "vproto3-json-serializer": "workspace:*",
    "vprotobufjs": "workspace:*",
    "vretry-request": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vgoogle-gax"
  }
}
