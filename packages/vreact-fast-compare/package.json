{
  "name": "vreact-fast-compare",
  "version": "3.2.2",
  "description": "React-aware deep equality with bounded traversal and complete binary-view comparisons",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./runtime.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./runtime.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "runtime.mjs",
    "index.cjs",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vreact-fast-compare"
  }
}
