{
  "name": "vpicocolors",
  "version": "1.1.1",
  "description": "Independent terminal colors for build and test diagnostics",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./index.d.mts",
          "default": "./browser.mjs"
        },
        "require": {
          "types": "./index.d.cts",
          "default": "./browser.cjs"
        }
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.mts",
    "*.cts",
    "README.md",
    "PROVENANCE.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vpicocolors"
  },
  "browser": {
    "./index.cjs": "./browser.cjs",
    "./index.mjs": "./browser.mjs"
  }
}
