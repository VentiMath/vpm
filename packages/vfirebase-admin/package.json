{
  "name": "vfirebase-admin",
  "version": "14.5.0",
  "description": "Independent Firebase Admin application runtime for Auth, Firestore, Storage, Messaging and App Check",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./app": {
      "types": "./lib/app/index.d.ts",
      "require": "./lib/app/index.js",
      "import": "./lib/esm/app/index.js"
    },
    "./app-check": {
      "types": "./lib/app-check/index.d.ts",
      "require": "./lib/app-check/index.js",
      "import": "./lib/esm/app-check/index.js"
    },
    "./auth": {
      "types": "./lib/auth/index.d.ts",
      "require": "./lib/auth/index.js",
      "import": "./lib/esm/auth/index.js"
    },
    "./firestore": {
      "types": "./lib/firestore/index.d.ts",
      "require": "./lib/firestore/index.js",
      "import": "./lib/esm/firestore/index.js"
    },
    "./messaging": {
      "types": "./lib/messaging/index.d.ts",
      "require": "./lib/messaging/index.js",
      "import": "./lib/esm/messaging/index.js"
    },
    "./storage": {
      "types": "./lib/storage/index.d.ts",
      "require": "./lib/storage/index.js",
      "import": "./lib/esm/storage/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "app": [
        "lib/app"
      ],
      "app-check": [
        "lib/app-check"
      ],
      "auth": [
        "lib/auth"
      ],
      "firestore": [
        "lib/firestore"
      ],
      "messaging": [
        "lib/messaging"
      ],
      "storage": [
        "lib/storage"
      ]
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "PROVENANCE.json",
    "README.md"
  ],
  "dependencies": {
    "vgoogle-auth-library": "workspace:*",
    "vjsonwebtoken": "workspace:*",
    "vjwks-rsa": "workspace:*"
  },
  "optionalDependencies": {
    "vgoogle-cloud-firestore": "workspace:*",
    "vgoogle-cloud-storage": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vfirebase-admin"
  }
}
