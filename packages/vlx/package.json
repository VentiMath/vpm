{
  "name": "vlx",
  "version": "0.2.0",
  "description": "VentiLaTeX: independent math rendering for web, React, MathML, SVG and problem pictures",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./png": {
      "types": "./png.d.ts",
      "import": "./png.mjs",
      "require": "./png.cjs"
    },
    "./package.json": "./package.json",
    "./problem": {
      "types": "./problem.d.ts",
      "import": "./problem.mjs",
      "require": "./problem.cjs"
    },
    "./dom": {
      "types": "./dom.d.ts",
      "import": "./dom.mjs",
      "require": "./dom.cjs"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.mjs",
      "require": "./react.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.d.ts",
    "README.md",
    "ACCESSIBILITY.md",
    "LICENSE",
    "PROVENANCE.json",
    "font",
    "*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "react": ">=19 <20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vlx"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "vpngjs": "7.0.0"
  }
}
