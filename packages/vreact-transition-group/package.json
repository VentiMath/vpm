{
  "name": "vreact-transition-group",
  "version": "4.4.5",
  "description": "Independent explicit-ref React transitions for MUI callers",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./Transition": {
      "import": {
        "types": "./Transition.d.mts",
        "default": "./Transition.mjs"
      },
      "require": {
        "types": "./Transition.d.cts",
        "default": "./Transition.cjs"
      }
    },
    "./CSSTransition": {
      "import": {
        "types": "./CSSTransition.d.mts",
        "default": "./CSSTransition.mjs"
      },
      "require": {
        "types": "./CSSTransition.d.cts",
        "default": "./CSSTransition.cjs"
      }
    },
    "./TransitionGroup": {
      "import": {
        "types": "./TransitionGroup.d.mts",
        "default": "./TransitionGroup.mjs"
      },
      "require": {
        "types": "./TransitionGroup.d.cts",
        "default": "./TransitionGroup.cjs"
      }
    }
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.cts",
    "*.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vreact-transition-group"
  }
}
