  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vemotion-babel-plugin"
  },
  "dependencies": {
    "vemotion-hash": "0.1.0",
