{
  "name": "vemotion-serialize",
  "version": "0.1.0",
  "description": "Serializes Emotion style objects, templates and interpolations to CSS and class names",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#is-development": {
      "development": "./src/conditions/true.js",
      "default": "./src/conditions/false.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vemotion-serialize"
  },
  "dependencies": {
    "vemotion-hash": "0.1.0",
    "vemotion-memoize": "0.1.0",
    "vemotion-unitless": "0.1.0",
    "vemotion-utils": "0.1.0"
  },
  "peerDependencies": {
    "csstype": "^3.1.3"
  },
  "vpm": {
    "platform": "browser"
  }
}
