{
  "name": "vhoist-non-react-statics",
  "version": "3.3.2",
  "description": "Copy component statics with preserved descriptors and bounded inheritance traversal",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./runtime.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./runtime.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "runtime.mjs",
    "index.cjs",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "PROVENANCE.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vhoist-non-react-statics"
  }
}
