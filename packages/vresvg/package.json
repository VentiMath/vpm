{
  "name": "vresvg",
  "version": "2.6.2",
  "description": "In-house SVG rasterization for VentiMath handwriting and VLX pictures",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./internal-raster": "./raster.cjs",
    "./internal-paths": "./raster-paths.cjs",
    "./internal-png": "./raster-png.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "vpngjs": "7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vresvg"
  }
}
