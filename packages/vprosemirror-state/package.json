{
  "name": "vprosemirror-state",
  "version": "1.4.4",
  "description": "Independent rich-text editor state, selections, transactions and plugins",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    }
  },
  "files": [
    "*.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "index.d.mts"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "vprosemirror-model": "1.25.12",
    "vprosemirror-transform": "1.12.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vprosemirror-state"
  },
  "vpm": {
    "platform": "browser"
  },
  "peerDependencies": {
    "prosemirror-view": "^1.27.0"
  },
  "peerDependenciesMeta": {
    "prosemirror-view": {
      "optional": true
    }
  }
}
