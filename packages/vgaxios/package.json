{
  "name": "vgaxios",
  "version": "0.1.0",
  "description": "Google HTTP client APIs on VPM transport with validated retries and isolated request state",
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
