{
  "name": "vserve-static",
  "version": "0.1.0",
  "description": "Static file middleware with VPM dependencies, stable options, and isolated redirect formatting",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "index.d.ts", "README.md", "LICENSE"],
  "dependencies": {
    "vencodeurl": "workspace:*",
    "vescape-html": "workspace:*",
    "vparseurl": "workspace:*",
    "vsend": "workspace:*"
  },
  "engines": { "node": ">=24" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventimath/vpm.git",
    "directory": "packages/vserve-static"
  },
  "homepage": "https://github.com/ventimath/vpm/tree/main/packages/vserve-static"
}
