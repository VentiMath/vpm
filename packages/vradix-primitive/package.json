{
  "name": "vradix-primitive",
  "version": "1.2.0",
  "description": "Independent Radix event composition and DOM ownership helpers",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./is-development": {
      "development": {
        "types": "./development.d.ts",
        "import": "./development.mjs",
        "require": "./development.cjs"
      },
      "production": {
        "types": "./production.d.ts",
        "import": "./production.mjs",
        "require": "./production.cjs"
      },
      "default": {
        "types": "./production.d.ts",
        "import": "./production.mjs",
        "require": "./production.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vradix-primitive"
  }
}
