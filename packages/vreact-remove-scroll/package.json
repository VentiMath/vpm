{
  "name": "vreact-remove-scroll",
  "version": "2.7.2",
  "description": "Independent React scroll isolation with document-scoped listeners",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./UI": {
      "types": "./ui.d.ts",
      "import": "./ui.mjs",
      "require": "./ui.cjs"
    },
    "./sidecar": {
      "types": "./sidecar.d.ts",
      "import": "./sidecar.mjs",
      "require": "./sidecar.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "ui.cjs",
    "ui.mjs",
    "ui.d.ts",
    "sidecar.cjs",
    "sidecar.mjs",
    "sidecar.d.ts",
    "effects.cjs",
    "controller.cjs",
    "medium.cjs",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "dependencies": {
    "vreact-remove-scroll-bar": "workspace:*",
    "vreact-style-singleton": "workspace:*",
    "vuse-callback-ref": "workspace:*",
    "vuse-sidecar": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": [
    "./sidecar.cjs",
    "./sidecar.mjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vreact-remove-scroll"
  }
}
