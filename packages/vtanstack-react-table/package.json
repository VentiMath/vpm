{
  "name": "vtanstack-react-table",
  "version": "9.3.1",
  "description": "Independent React 19 adapter for current and legacy flat-data tables",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./legacy": {
      "import": {
        "types": "./legacy.d.mts",
        "default": "./legacy.mjs"
      },
      "require": {
        "types": "./legacy.d.cts",
        "default": "./legacy.cjs"
      }
    },
    "./flex-render": {
      "import": {
        "types": "./flex-render.d.mts",
        "default": "./flex-render.mjs"
      },
      "require": {
        "types": "./flex-render.d.cts",
        "default": "./flex-render.cjs"
      }
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "legacy.cjs",
    "legacy.mjs",
    "legacy.d.cts",
    "legacy.d.mts",
    "flex-render.cjs",
    "flex-render.mjs",
    "flex-render.d.cts",
    "flex-render.d.mts"
  ],
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "vtanstack-table-core": "workspace:*",
    "vtanstack-store": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vtanstack-react-table"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
