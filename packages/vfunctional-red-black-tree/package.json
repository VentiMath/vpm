{
  "name": "vfunctional-red-black-tree",
  "version": "0.1.0",
  "description": "Persistent red-black trees for Firestore listeners, with checked index lookups",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.js"
    },
