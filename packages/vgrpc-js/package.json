{
  "name": "vgrpc-js",
  "version": "1.14.7",
  "description": "Independent application-scope gRPC HTTP/2 client with retained server compatibility",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json",
    "./build/src/*": {
      "types": "./build/src/*.d.ts",
      "default": "./build/src/*.js"
    },
    "./build/src/*.js": {
      "types": "./build/src/*.d.ts",
      "default": "./build/src/*.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "build/src",
    "proto",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "client-runtime"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "vgrpc-proto-loader": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vgrpc-js"
  }
}
