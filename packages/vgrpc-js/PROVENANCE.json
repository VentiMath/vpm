  "changes": [
    "Uses vgrpc-proto-loader and vordered-map.",
    "Complete frames use one copied slice; fragmented-message inputs are released after emission.",
    "Metadata conversion preserves own __proto__ properties and parses combined custom binary headers in arrays with case-insensitive names.",
    "Metadata parsing avoids redundant case conversion for text headers; cloning reuses its value mapper.",
    "Namespace construction does not traverse inherited Object members.",
    "Explicit structural platform declarations and Node 24 runtime baseline."
  ],
  "scope": "Retains upstream HTTP/2 client/server, retries, resolvers, load balancing, credentials and experimental exports. Verification scope is documented separately; not an application deployment."
}
