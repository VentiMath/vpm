{
  "name": "vdiff",
  "version": "9.0.0",
  "description": "Independent word diffs for VentiMath proposed problem edits",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vdiff"
  }
}
