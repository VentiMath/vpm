{
  "name": "vradix-react-arrow",
  "version": "1.1.17",
  "description": "Independent Radix SVG arrows using VPM primitives and shared immutable geometry",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["index.cjs", "index.mjs", "index.d.ts", "README.md", "LICENSE", "PROVENANCE.json"],
  "engines": { "node": ">=24" },
  "vpm": { "platform": "browser" },
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "dependencies": { "vradix-react-primitive": "2.2.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vradix-react-arrow"
  }
}
