{
  "name": "vmaterial-react-table",
  "version": "3.2.1",
  "description": "Independent Material UI table controls for VentiMath flat-data callers",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "license": "MIT",
  "dependencies": {
    "vtanstack-react-table": "workspace:*",
    "vtanstack-match-sorter-utils": "workspace:*",
    "vhighlight-words": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mui/material": ">=6 <9",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vmaterial-react-table"
  }
}
