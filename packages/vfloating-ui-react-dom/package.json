{
  "name": "vfloating-ui-react-dom",
  "version": "0.1.0",
  "description": "Independent React positioning hooks on VPM Floating UI",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./runtime.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./runtime.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "*.cjs",
    "*.cts",
    "*.mts",
    "README.md",
    "PROVENANCE.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vfloating-ui-react-dom"
  },
  "dependencies": {
    "vfloating-ui-dom": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
