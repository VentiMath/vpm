{
  "name": "vreact-autosuggest",
  "version": "10.1.0",
  "description": "Independent controlled navigation suggestions for React",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.cts",
    "*.mts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "vreact-themeable": "1.1.0",
    "vsection-iterator": "2.0.0",
    "vshallow-equal": "3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vreact-autosuggest"
  }
}
