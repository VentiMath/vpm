{
  "name": "vradix-react-popper",
  "version": "1.4.0",
  "description": "Independent Radix positioning components with VPM Floating UI and owned anchor lifecycles",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "sideEffects": false,
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "vfloating-ui-react-dom": "2.1.9",
    "vradix-react-primitive": "2.2.0",
    "vradix-react-arrow": "1.1.17",
    "vradix-react-context": "1.3.0",
    "vradix-react-compose-refs": "1.1.5",
    "vradix-react-use-layout-effect": "1.1.4",
    "vradix-react-use-callback-ref": "1.1.5",
    "vradix-react-use-size": "1.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vradix-react-popper"
  }
}
