{
  "name": "vmui-styled-engine",
  "version": "9.5.0",
  "description": "MUI styling adapter over the VPM Emotion foundation",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./GlobalStyles": {
      "import": {
        "types": "./GlobalStyles.d.mts",
        "default": "./GlobalStyles.mjs"
      },
      "require": {
        "types": "./GlobalStyles.d.cts",
        "default": "./GlobalStyles.cjs"
      }
    },
    "./StyledEngineProvider": {
      "import": {
        "types": "./StyledEngineProvider.d.mts",
        "default": "./StyledEngineProvider.mjs"
      },
      "require": {
        "types": "./StyledEngineProvider.d.cts",
        "default": "./StyledEngineProvider.cjs"
      }
    }
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.mts",
    "*.cts",
    "README.md",
    "PROVENANCE.json",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "vpm": {
    "platform": "browser"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VentiMath/vpm.git",
    "directory": "packages/vmui-styled-engine"
  },
  "dependencies": {
    "vemotion-react": "11.14.0",
    "vemotion-styled": "11.14.1",
    "vemotion-serialize": "1.3.3"
  }
}
